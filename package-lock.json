{
  "name": "devdeck",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "devdeck",
      "workspaces": [
        "apps/*",
        "packages/*"
      ]
    },
    "apps/dashboard": {
      "name": "@devdeck/dashboard",
      "version": "0.0.0"
    },
    "node_modules/@devdeck/cli": {
      "resolved": "packages/cli",
      "link": true
    },
    "node_modules/@devdeck/config": {
      "resolved": "packages/config",
      "link": true
    },
    "node_modules/@devdeck/core": {
      "resolved": "packages/core",
      "link": true
    },
    "node_modules/@devdeck/dashboard": {
      "resolved": "apps/dashboard",
      "link": true
    },
    "node_modules/@devdeck/server": {
      "resolved": "packages/server",
      "link": true
    },
    "packages/cli": {
      "name": "@devdeck/cli",
      "version": "0.0.0",
      "bin": {
        "devdeck": "dist/index.js"
      }
    },
    "packages/config": {
      "name": "@devdeck/config",
      "version": "0.0.0"
    },
    "packages/core": {
      "name": "@devdeck/core",
      "version": "0.0.0"
    },
    "packages/server": {
      "name": "@devdeck/server",
      "version": "0.0.0"
    }
  }
}
