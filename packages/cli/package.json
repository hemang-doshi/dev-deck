{
  "name": "@devdeck/cli",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "devdeck": "dist/index.js"
  },
  "scripts": {
    "build": "npm --prefix ../.. run build --workspace @devdeck/config --workspace @devdeck/core --workspace @devdeck/server && tsc -p tsconfig.json",
    "test": "npm --prefix ../.. run build --workspace @devdeck/config --workspace @devdeck/core --workspace @devdeck/server && vitest run",
    "lint": "npm --prefix ../.. run build --workspace @devdeck/config --workspace @devdeck/core --workspace @devdeck/server && tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@devdeck/config": "1.0.0",
    "@devdeck/core": "1.0.0",
    "@devdeck/server": "1.0.0"
  }
}
